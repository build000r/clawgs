## chart erd Clawgs.v2 Data Contract ERD
```mermaid
erDiagram
  EXTRACT ||--|| SOURCE : has
  EXTRACT ||--|| SNAPSHOT : has
  EXTRACT ||--|| STATS : has
  SNAPSHOT ||--o| ACTION : "current_tool"
  SNAPSHOT ||--o{ ACTION : "recent_actions"
  SNAPSHOT ||--o| COMMITSIGNAL : "commit_signal (codex)"
  SNAPSHOT ||--o{ ACTIONCUE : "action_cues"
  EXTRACT {
    string schema_version "GREEN fixed clawgs.v2"
    string generated_at "ISO-8601 UTC"
    array raw_events "optional --include-raw"
  }
  SOURCE {
    string tool "claude|codex"
    string path
    bool discovered
    string cwd
  }
  SNAPSHOT {
    string user_task
    number token_count
    bool awaiting_user_input
  }
  STATS {
    number events_seen
    number malformed_lines_skipped
    number bytes_read
  }
  ACTION {
    string tool
    string detail
    string kind "tool_use|text|thinking|function_call|other"
    string ts
  }
  COMMITSIGNAL {
    bool candidate
    bool edited
    bool validated
    bool dirty_checked
    bool commit_seen
  }
  ACTIONCUE {
    string kind "awaiting_user|commit_ready|validation_missing_after_edit|dirty_check_missing"
    string status "active"
    string confidence "deterministic"
  }
```
