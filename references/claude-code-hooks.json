{
  "hooks": {
    "Notification": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "clawgs claude-hook-notify --socket \"$HOME/.tmux/clawgs-tmux.sock\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "clawgs claude-hook-notify --socket \"$HOME/.tmux/clawgs-tmux.sock\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "clawgs claude-hook-notify --socket \"$HOME/.tmux/clawgs-tmux.sock\""
          }
        ]
      }
    ]
  }
}
