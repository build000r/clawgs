{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:clawgs:v2",
  "title": "clawgs.v2 extract output",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source", "snapshot", "stats", "generated_at"],
  "properties": {
    "schema_version": {
      "const": "clawgs.v2"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "snapshot": {
      "$ref": "#/$defs/snapshot"
    },
    "stats": {
      "$ref": "#/$defs/stats"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "raw_events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool", "path", "discovered", "cwd"],
      "properties": {
        "tool": {
          "enum": ["claude", "codex"]
        },
        "path": {
          "type": "string"
        },
        "discovered": {
          "type": "boolean"
        },
        "cwd": {
          "type": "string"
        }
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["token_count", "recent_actions"],
      "properties": {
        "user_task": {
          "type": ["string", "null"]
        },
        "current_tool": {
          "anyOf": [
            {
              "$ref": "#/$defs/action"
            },
            {
              "type": "null"
            }
          ]
        },
        "token_count": {
          "type": "integer",
          "minimum": 0
        },
        "awaiting_user_input": {
          "type": "boolean"
        },
        "awaiting_user_text": {
          "type": ["string", "null"]
        },
        "recent_actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/action"
          }
        },
        "commit_signal": {
          "$ref": "#/$defs/commit_signal"
        },
        "action_cues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/action_cue"
          }
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool", "kind"],
      "properties": {
        "tool": {
          "type": "string"
        },
        "detail": {
          "type": ["string", "null"]
        },
        "kind": {
          "enum": ["tool_use", "text", "thinking", "function_call", "other"]
        },
        "ts": {
          "type": ["string", "null"],
          "format": "date-time"
        }
      }
    },
    "commit_signal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate", "edited", "validated", "dirty_checked", "commit_seen"],
      "properties": {
        "candidate": {
          "type": "boolean"
        },
        "edited": {
          "type": "boolean"
        },
        "validated": {
          "type": "boolean"
        },
        "dirty_checked": {
          "type": "boolean"
        },
        "commit_seen": {
          "type": "boolean"
        }
      }
    },
    "action_cue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "status", "source", "confidence", "evidence"],
      "properties": {
        "kind": {
          "$ref": "#/$defs/action_cue_kind"
        },
        "status": {
          "$ref": "#/$defs/action_cue_status"
        },
        "source": {
          "$ref": "#/$defs/action_cue_source"
        },
        "confidence": {
          "$ref": "#/$defs/action_cue_confidence"
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/action_cue_evidence_label"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "kind": { "const": "awaiting_user" } },
            "required": ["kind"]
          },
          "then": {
            "properties": { "evidence": { "const": ["awaiting_user_input"] } }
          }
        },
        {
          "if": {
            "properties": { "kind": { "const": "commit_ready" } },
            "required": ["kind"]
          },
          "then": {
            "properties": {
              "evidence": {
                "const": [
                  "edit_seen",
                  "validation_succeeded",
                  "dirty_tree_checked_after_latest_edit",
                  "commit_not_seen_after_latest_edit"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": { "kind": { "const": "validation_missing_after_edit" } },
            "required": ["kind"]
          },
          "then": {
            "properties": {
              "evidence": {
                "const": [
                  "edit_seen",
                  "fresh_validation_not_seen",
                  "commit_not_seen_after_latest_edit"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": { "kind": { "const": "dirty_check_missing" } },
            "required": ["kind"]
          },
          "then": {
            "properties": {
              "evidence": {
                "const": [
                  "edit_seen",
                  "validation_succeeded",
                  "dirty_tree_check_not_seen_after_latest_edit",
                  "commit_not_seen_after_latest_edit"
                ]
              }
            }
          }
        }
      ]
    },
    "action_cue_kind": {
      "enum": [
        "awaiting_user",
        "commit_ready",
        "validation_missing_after_edit",
        "dirty_check_missing"
      ]
    },
    "action_cue_status": {
      "enum": ["active"]
    },
    "action_cue_source": {
      "enum": ["transcript"]
    },
    "action_cue_confidence": {
      "enum": ["deterministic"]
    },
    "action_cue_evidence_label": {
      "enum": [
        "awaiting_user_input",
        "edit_seen",
        "validation_succeeded",
        "dirty_tree_checked_after_latest_edit",
        "dirty_tree_check_not_seen_after_latest_edit",
        "fresh_validation_not_seen",
        "commit_not_seen_after_latest_edit"
      ]
    },
    "stats": {
      "type": "object",
      "additionalProperties": false,
      "required": ["events_seen", "malformed_lines_skipped", "bytes_read"],
      "properties": {
        "events_seen": {
          "type": "integer",
          "minimum": 0
        },
        "malformed_lines_skipped": {
          "type": "integer",
          "minimum": 0
        },
        "bytes_read": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
